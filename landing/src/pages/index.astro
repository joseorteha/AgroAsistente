---
const features = [
  {
    icon: `<svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path stroke="#32d74b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>`,
    title: 'Diagnóstico de plagas',
    desc: 'Describe los síntomas de tus plantas. El agente cruza los manuales técnicos con los datos reales de tu lote y te da un diagnóstico personalizado, no una respuesta genérica.',
  },
  {
    icon: `<svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path stroke="#32d74b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
    title: 'Precios del mercado',
    desc: 'Consulta el precio del café por kilogramo y por arroba. Diferencia entre café convencional, orgánico y certificado Fair Trade, según tu tipo de producción.',
  },
  {
    icon: `<svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path stroke="#32d74b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    title: 'Tu finca en datos',
    desc: 'Accede al estado fenológico de tus lotes, al inventario de insumos aplicados y a las alertas sanitarias activas. Todo desde una conversación por Telegram.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Escríbele por Telegram',
    desc: 'Preséntate con tu nombre. El agente identifica tu finca automáticamente y carga todos tus datos.',
  },
  {
    number: '02',
    title: 'Busca en manuales técnicos',
    desc: 'El sistema RAG recupera los fragmentos más relevantes de las guías técnicas agrícolas especializadas.',
  },
  {
    number: '03',
    title: 'Consulta los datos de tu finca',
    desc: 'Accede a tu historial real: altitud del lote, variedad, insumos recientes y alertas activas.',
  },
  {
    number: '04',
    title: 'Respuesta personalizada',
    desc: 'La IA cruza ambas fuentes y responde como un agrónomo que conoce personalmente tu terreno.',
  },
];

const tech = [
  'n8n Cloud', 'Cohere AI', 'PostgreSQL', 'pgvector',
  'MySQL', 'Railway', 'Telegram Bot API', 'GitHub',
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="AgroAsistente — El agrónomo virtual que cuida tu café. Consultas personalizadas por Telegram, disponible 24/7 para caficultores en México." />
  <meta property="og:title" content="AgroAsistente — Tu Agrónomo Virtual" />
  <meta property="og:description" content="El agrónomo virtual que cuida tu café. Disponible 24/7 por Telegram." />
  <meta property="og:image" content="/workflow.png" />
  <title>AgroAsistente — Tu Agrónomo Virtual</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>

<body>

  <!-- ═══════════════════════ NAV ═══════════════════════ -->
  <nav>
    <div class="nav-inner">
      <a href="#" class="nav-logo" aria-label="AgroAsistente inicio">
        <img src="/LOGO.png" alt="AgroAsistente" height="34" />
      </a>
      <div class="nav-links">
        <a href="#como-funciona">¿Cómo funciona?</a>
        <a href="#tecnologia">Stack</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar tema">
          <svg class="icon-sun" width="18" height="18" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="icon-moon" width="18" height="18" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a
          href="https://github.com/joseorteha/AgroAsistente"
          target="_blank"
          rel="noopener"
          class="btn-github"
        >
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.341-3.369-1.341-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════ HERO ═══════════════════════ -->
  <section class="hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>

    <div class="container hero-content">
      <div class="hero-badge reveal">
        <span class="live-dot"></span>
        ONE · Inmersión Agentes de IA · Alura LATAM
      </div>

      <h1 class="hero-title reveal">
        El agrónomo virtual<br />que cuida tu café.
      </h1>

      <p class="hero-subtitle reveal">
        AgroAsistente responde tus preguntas de cultivo por Telegram, las 24 horas.
        Conoce tu finca, tus lotes y tu historial. No respuestas genéricas — asesoría personalizada.
      </p>

      <div class="hero-cta reveal">
        <a href="https://t.me/agroasistente_bot" target="_blank" rel="noopener" class="btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06-.01.24-.02.27z"/>
          </svg>
          Hablar con AgroAsistente
        </a>
        <a href="https://github.com/joseorteha/AgroAsistente" target="_blank" rel="noopener" class="btn-secondary">
          Ver código fuente
        </a>
      </div>
    </div>

    <div class="scroll-hint reveal" aria-hidden="true">
      <span class="scroll-line"></span>
    </div>
  </section>

  <!-- ═══════════════════════ STRIP ═══════════════════════ -->
  <section class="strip">
    <div class="container">
      <p class="strip-text reveal">
        En México, miles de productores cafetaleros toman decisiones críticas sobre plagas,
        fertilización y precios sin acceso a un ingeniero agrónomo.
        <strong>AgroAsistente cambia eso.</strong>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURES ═══════════════════════ -->
  <section class="section features-section">
    <div class="container">
      <p class="eyebrow reveal">¿Qué puede hacer?</p>
      <h2 class="section-title reveal">Todo lo que necesitas<br />desde un mensaje.</h2>

      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-card reveal">
            <div class="feature-icon" set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ VIDEO ═══════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow reveal">El sistema por dentro</p>
      <h2 class="section-title reveal">Mira cómo funciona.</h2>
      <p class="section-body reveal">
        Así procesa AgroAsistente cada consulta. El flujo completo desde el mensaje de
        Telegram hasta la respuesta personalizada, construido en n8n con IA de Cohere.
      </p>
      <div class="media-frame reveal">
        <div class="media-chrome">
          <span></span><span></span><span></span>
        </div>
        <video autoplay muted loop playsinline>
          <source src="/rag.mp4" type="video/mp4" />
          Tu navegador no soporta video HTML5.
        </video>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ SCREENSHOT ═══════════════════════ -->
  <section class="section" id="como-funciona">
    <div class="container">
      <p class="eyebrow reveal">Arquitectura real</p>
      <h2 class="section-title reveal">Un agente que razona,<br />busca y responde.</h2>
      <p class="section-body reveal">
        No es un chatbot. Es un sistema de inteligencia artificial con herramientas propias:
        busca en manuales técnicos, consulta la base de datos de tu finca y cruza la
        información antes de responder.
      </p>
      <div class="media-frame reveal">
        <div class="media-chrome">
          <span></span><span></span><span></span>
        </div>
        <img
          src="/workflow.png"
          alt="Flujo completo de AgroAsistente en n8n"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ STEPS ═══════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow reveal">El proceso</p>
      <h2 class="section-title reveal">De tu pregunta<br />a la respuesta exacta.</h2>

      <div class="steps-grid">
        {steps.map((s) => (
          <div class="step reveal">
            <div class="step-number">{s.number}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ IMPACT ═══════════════════════ -->
  <section class="section impact-section">
    <div class="impact-glow" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow reveal">El propósito</p>
      <blockquote class="impact-quote reveal">
        "Cada consulta puede marcar<br class="hide-mobile" /> la diferencia entre perder<br class="hide-mobile" /> o salvar una cosecha."
      </blockquote>
      <p class="impact-body reveal">
        AgroAsistente está diseñado para los productores que más lo necesitan:
        los que no tienen a nadie a quien llamarle cuando sus plantas enferman
        o cuando no saben si el precio que les ofrecen es justo.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════ TECH ═══════════════════════ -->
  <section class="section section-alt" id="tecnologia">
    <div class="container">
      <p class="eyebrow reveal">Tecnología</p>
      <h2 class="section-title reveal">Construido con las<br />mejores herramientas.</h2>
      <div class="tech-pills reveal">
        {tech.map((t) => (
          <span class="tech-pill">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CERTIFICATE ═══════════════════════ -->
  <section class="section cert-section">
    <div class="container">
      <div class="cert-card reveal">
        <div class="cert-logo">
          <img src="/certificado.png" alt="AgroAsistente" height="120" />
        </div>
        <p class="cert-label">Certificado de Participación</p>
        <h3 class="cert-name">Jose Bernardino Tlehuactle Ortega</h3>
        <p class="cert-detail">
          Completó la <strong>ONE | Inmersión Agentes de IA</strong>
        </p>
        <p class="cert-detail">Alura LATAM · Oracle Next Education · Mayo 2026</p>
        <div class="cert-divider"></div>
        <p class="cert-footer">
          Este proyecto fue construido como aplicación práctica de esa inmersión,<br />
          con una idea propia y con impacto social real.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
  <footer>
    <div class="container footer-inner">
      <img src="/LOGO.png" alt="AgroAsistente" height="20" />
      <p class="footer-text">Diseñado para los caficultores de México &middot; 2026</p>
      <div class="footer-links">
        <a href="https://github.com/joseorteha/AgroAsistente" target="_blank" rel="noopener">GitHub</a>
        <a href="https://t.me/agroasistente_bot" target="_blank" rel="noopener">Telegram</a>
      </div>
    </div>
  </footer>

</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:          #ffffff;
    --bg-2:        #f5f5f7;
    --bg-3:        #e8e8ed;
    --bg-card:     rgba(255,255,255,0.72);
    --bg-nav:      rgba(255,255,255,0.82);
    --border:      rgba(0, 0, 0, 0.06);
    --border-lg:   rgba(0, 0, 0, 0.10);
    --text-1:      #1d1d1f;
    --text-2:      #6e6e73;
    --text-3:      #86868b;
    --green:       #34c759;
    --green-soft:  rgba(52,199,89,0.10);
    --green-glow:  rgba(52,199,89,0.15);
    --font:        'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --radius:      20px;
    --max-w:       1080px;
    --shadow-sm:   0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.06);
    --shadow-md:   0 4px 20px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);
    --shadow-lg:   0 20px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04);
    color-scheme: light;
  }

  [data-theme="dark"] {
    --bg:          #000000;
    --bg-2:        #0a0a0a;
    --bg-3:        #1c1c1e;
    --bg-card:     rgba(28,28,30,0.72);
    --bg-nav:      rgba(0,0,0,0.82);
    --border:      rgba(255,255,255,0.08);
    --border-lg:   rgba(255,255,255,0.14);
    --text-1:      #f5f5f7;
    --text-2:      #a1a1a6;
    --text-3:      #6e6e73;
    --green:       #30d158;
    --green-soft:  rgba(48,209,88,0.12);
    --green-glow:  rgba(48,209,88,0.18);
    --shadow-sm:   0 1px 3px rgba(0,0,0,0.3);
    --shadow-md:   0 4px 20px rgba(0,0,0,0.4);
    --shadow-lg:   0 20px 60px rgba(0,0,0,0.5);
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text-1);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    transition: background 0.4s ease, color 0.4s ease;
  }

  /* ── Scroll reveal ─────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s cubic-bezier(.16,1,.3,1),
                transform 0.75s cubic-bezier(.16,1,.3,1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Layout helpers ─────────────────────────────────── */
  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 28px;
  }

  .section {
    padding: 120px 0;
  }
  .section-alt {
    background: var(--bg-2);
  }

  /* ── Typography shared ──────────────────────────────── */
  .eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
    text-align: center;
    margin-bottom: 14px;
  }

  .section-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-1);
    text-align: center;
    margin-bottom: 22px;
  }

  .section-body {
    font-size: 1.15rem;
    color: var(--text-2);
    max-width: 560px;
    line-height: 1.75;
    text-align: center;
    margin: 0 auto 56px;
  }

  /* ════════════════ NAV ════════════════ */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 999;
    height: 64px;
    display: flex;
    align-items: center;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
    transition: background 0.4s;
  }

  .nav-inner {
    max-width: var(--max-w);
    width: 100%;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo { display: flex; align-items: center; text-decoration: none; }
  .nav-logo img {
    display: block;
    width: auto;
    height: 34px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text-1); }

  .btn-github {
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem !important;
    color: var(--text-1) !important;
    background: var(--bg-3) !important;
    border: 1px solid var(--border) !important;
    border-radius: 100px;
    padding: 6px 16px;
    transition: background 0.2s, border-color 0.2s, transform 0.2s !important;
  }
  .btn-github:hover {
    background: var(--green-soft) !important;
    border-color: var(--green) !important;
    transform: scale(1.03);
  }

  /* ════════════════ HERO ════════════════ */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 120px 28px 90px;
    background: radial-gradient(ellipse 80% 50% at 50% 0%,
      var(--green-glow) 0%,
      transparent 70%),
      var(--bg);
    transition: background 0.4s;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    opacity: 0.25;
  }
  .hero-orb-1 {
    width: 600px; height: 600px;
    top: -200px; left: -150px;
    background: radial-gradient(circle, var(--green-glow), transparent 70%);
  }
  .hero-orb-2 {
    width: 500px; height: 500px;
    bottom: -150px; right: -100px;
    background: radial-gradient(circle, var(--green-glow), transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-2);
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 8px 20px;
    margin-bottom: 40px;
    box-shadow: var(--shadow-sm);
    transition: background 0.4s, border-color 0.4s;
  }

  .live-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(50,215,75,0.4); }
    50%       { opacity: 0.7; box-shadow: 0 0 0 5px rgba(50,215,75,0); }
  }

  .hero-title {
    font-size: clamp(3rem, 8.5vw, 5.5rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin-bottom: 28px;
    background: linear-gradient(160deg, var(--text-1) 30%, var(--green) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--text-2);
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: 52px;
  }

