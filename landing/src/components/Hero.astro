---
---

<section class="hero" id="hero">
  <!-- Animated orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>
  <div class="orb orb-3" aria-hidden="true"></div>

  <!-- CSS particles -->
  <div class="particles" aria-hidden="true">
    {Array.from({length: 14}).map((_, i) => (
      <span class="particle" style={`--i:${i}`}></span>
    ))}
  </div>

  <div class="container hero-content">
    <!-- Badge -->
    <div class="hero-badge">
      <span class="live-dot"></span>
      ONE · Inmersión Agentes de IA · Alura LATAM
    </div>

    <!-- Animated title (word-by-word) -->
    <h1 class="hero-title">
      <span class="hero-line">
        <span class="ww"><span class="w">El</span></span>
        <span class="ww"><span class="w">agrónomo</span></span>
        <span class="ww"><span class="w">virtual</span></span>
      </span>
      <span class="hero-line">
        <span class="ww"><span class="w">que</span></span>
        <span class="ww"><span class="w">cuida</span></span>
        <span class="ww"><span class="w">tu</span></span>
        <span class="ww"><span class="w grad">café.</span></span>
      </span>
    </h1>

    <p class="hero-subtitle">
      AgroAsistente responde tus preguntas de cultivo por Telegram, las 24 horas.
      Conoce tu finca, tus lotes y tu historial.
      No respuestas genéricas — asesoría personalizada.
    </p>

    <div class="hero-cta">
      <a href="https://t.me/agroasistente_bot" target="_blank" rel="noopener" class="btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06-.01.24-.02.27z"/>
        </svg>
        Hablar con AgroAsistente
      </a>
      <a href="https://github.com/joseorteha/AgroAsistente" target="_blank" rel="noopener" class="btn-secondary">
        Ver código fuente
      </a>
    </div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 120px 28px 100px;
    background: var(--bg);
    transition: background 0.4s;
  }

  /* Orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(90px);
  }
  .orb-1 {
    width: 700px; height: 700px;
    top: -280px; left: -180px;
    background: radial-gradient(circle, var(--green) 0%, transparent 70%);
    opacity: 0.14;
    animation: orb-drift 16s ease-in-out infinite;
  }
  .orb-2 {
    width: 550px; height: 550px;
    bottom: -220px; right: -120px;
    background: radial-gradient(circle, var(--green) 0%, transparent 70%);
    opacity: 0.12;
    animation: orb-drift 20s ease-in-out infinite reverse;
  }
  .orb-3 {
    width: 350px; height: 350px;
    top: 35%; right: 15%;
    background: radial-gradient(circle, var(--green) 0%, transparent 70%);
    opacity: 0.07;
    animation: orb-drift 25s ease-in-out infinite 4s;
  }

  /* Particles */
  .particles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .particle {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--green);
    opacity: 0;
    animation: ptcl calc(5s + var(--i, 0) * 0.7s) ease-in-out infinite calc(var(--i, 0) * 0.6s);
    left: calc(8% + var(--i, 0) * 6.5%);
    top: calc(30% + (var(--i, 0) * 5%));
  }
  @keyframes ptcl {
    0%   { transform: translateY(0)     scale(0); opacity: 0; }
    20%  { opacity: 0.55; transform: scale(1); }
    80%  { opacity: 0.2; }
    100% { transform: translateY(-70px) scale(0); opacity: 0; }
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-2);
    background: var(--bg-card);
    backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 8px 20px;
    margin-bottom: 44px;
    box-shadow: var(--sh-sm);
    animation: fadeSlideUp 0.8s cubic-bezier(.16,1,.3,1) 0.1s both;
    transition: background 0.4s;
  }
  .live-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    animation: pulse 2.4s ease-in-out infinite;
  }

  /* Title — word-by-word */
  .hero-title {
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.036em;
    margin-bottom: 30px;
    color: var(--text-1);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* Each line is a flex row so gaps = word spacing */
  .hero-line {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.22em;
    margin-bottom: 0.02em;
  }
  /* Clip container per word */
  .ww {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .w {
    display: inline-block;
    animation: wordUp 0.9s cubic-bezier(.16,1,.3,1) both;
  }
  /* Stagger delays per word */
  .hero-line:nth-child(1) .ww:nth-child(1) .w { animation-delay: 0.15s; }
  .hero-line:nth-child(1) .ww:nth-child(2) .w { animation-delay: 0.28s; }
  .hero-line:nth-child(1) .ww:nth-child(3) .w { animation-delay: 0.41s; }
  .hero-line:nth-child(2) .ww:nth-child(1) .w { animation-delay: 0.54s; }
  .hero-line:nth-child(2) .ww:nth-child(2) .w { animation-delay: 0.67s; }
  .hero-line:nth-child(2) .ww:nth-child(3) .w { animation-delay: 0.80s; }
  .hero-line:nth-child(2) .ww:nth-child(4) .w { animation-delay: 0.93s; }

  .grad {
    background: linear-gradient(135deg, var(--text-1) 0%, var(--green) 65%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle */
  .hero-subtitle {
    font-size: clamp(1rem, 2.2vw, 1.22rem);
    color: var(--text-2);
    max-width: 560px;
    line-height: 1.78;
    margin-bottom: 52px;
    animation: fadeSlideUp 0.9s cubic-bezier(.16,1,.3,1) 0.95s both;
  }

  /* CTAs */
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeSlideUp 0.9s cubic-bezier(.16,1,.3,1) 1.1s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: var(--green);
    border: none;
    border-radius: 100px;
    padding: 16px 34px;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 24px var(--green-glow);
    transition: transform 0.3s cubic-bezier(.16,1,.3,1), box-shadow 0.3s;
  }
  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.18) 50%, transparent 100%);
    background-size: 200% 100%;
    animation: shimmer 2.2s linear infinite;
    pointer-events: none;
  }
  .btn-primary:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 44px var(--green-glow);
  }
  .btn-primary:active { transform: scale(0.98); }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-1);
    background: var(--bg-card);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-lg);
    border-radius: 100px;
    padding: 16px 34px;
    text-decoration: none;
    transition: background 0.3s, border-color 0.3s,
                transform 0.3s cubic-bezier(.16,1,.3,1);
  }
  .btn-secondary:hover {
    background: var(--green-soft);
    border-color: var(--green);
    transform: translateY(-3px) scale(1.02);
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 40px; left: 50%;
    transform: translateX(-50%);
    animation: fadeSlideUp 1s ease 1.4s both;
  }
  .scroll-line {
    display: block;
    width: 1px; height: 52px;
    background: linear-gradient(to bottom, transparent, var(--green));
    margin: 0 auto;
    animation: scroll-appear 2.2s ease-in-out infinite 1.6s;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero { padding: 100px 20px 90px; }
    .orb-1 { width: 400px; height: 400px; opacity: 0.10; }
    .orb-2 { width: 300px; height: 300px; opacity: 0.09; }
    .orb-3 { display: none; }
    .hero-cta { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-secondary { justify-content: center; }
  }
  @media (max-width: 480px) {
    .hero-title { font-size: clamp(2.5rem, 11vw, 3.5rem); }
    .hero-badge { font-size: 0.68rem; padding: 7px 14px; }
    .btn-primary, .btn-secondary { width: 100%; padding: 15px 24px; }
  }
</style>
