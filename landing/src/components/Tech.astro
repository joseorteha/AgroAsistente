---

<section class="section section-alt" id="tecnologia">
  <div class="container">
    <p class="eyebrow reveal">Tecnología</p>
    <h2 class="section-title reveal">Construido con las<br />mejores herramientas.</h2>

    <div class="tech-grid stagger">
      {tech.map(t => (
        <div class="tech-card reveal" style={`--brand: ${t.color}`}>
          <div class="tech-icon">
            <Fragment set:html={t.logo} />
          </div>
          <div class="tech-info">
            <span class="tech-name">{t.name}</span>
            <span class="tech-desc">{t.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 56px;
  }

  .tech-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 18px;
    background: var(--bg-card);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--sh-sm);
    cursor: default;
    transition:
      background  0.3s,
      border-color 0.3s,
      transform    0.4s cubic-bezier(.16,1,.3,1),
      box-shadow   0.3s;
  }
  .tech-card:hover {
    border-color: var(--brand, var(--green));
    transform: translateY(-5px) scale(1.02);
    box-shadow: var(--sh-md), 0 0 0 1px var(--brand, var(--green));
    background: color-mix(in srgb, var(--brand, var(--green)) 6%, var(--bg-card));
  }

  .tech-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: color-mix(in srgb, var(--brand, var(--green)) 12%, transparent);
    color: var(--brand, var(--green));
    transition: background 0.3s, transform 0.4s cubic-bezier(.16,1,.3,1);
  }
  .tech-icon svg {
    width: 22px;
    height: 22px;
  }
  .tech-card:hover .tech-icon {
    background: color-mix(in srgb, var(--brand, var(--green)) 20%, transparent);
    transform: scale(1.1) rotate(-5deg);
  }

  /* GitHub icon: dark in light mode, white in dark mode */
  .tech-card:last-child .tech-icon {
    color: #181717;
  }
  :global([data-theme="dark"]) .tech-card:last-child .tech-icon {
    color: #f0f0f0;
  }

  .tech-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .tech-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-1);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tech-desc {
    font-size: 0.72rem;
    color: var(--text-3);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
  @media (max-width: 400px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .tech-card  { padding: 14px 12px; gap: 10px; }
    .tech-icon  { width: 34px; height: 34px; }
    .tech-icon svg { width: 18px; height: 18px; }
  }
</style>
